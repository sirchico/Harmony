{
  "api_version": 2,
  "id": "gif-provider-switcher",
  "name": "GIF Provider Switcher",
  "version": "1.2.0",
  "author": "Harmony contributors",
  "license": "MIT OR Apache-2.0",
  "source": "https://github.com/sirchico/Harmony/tree/main/extensions/plugins/gif-provider-switcher",
  "kind": "plugin",
  "capabilities": [
    "gif_provider",
    "network"
  ],
  "origins": [
    "api.tenor.com",
    "api.giphy.com"
  ],
  "actions": [
    {
      "id": "search",
      "label": "Search GIFs",
      "surface": "gif_search"
    }
  ],
  "requires": {
    "features": {
      "gifs.provider": "^1.0",
      "network": "^1.0"
    }
  },
  "settings": [
    {
      "id": "provider",
      "label": "GIF provider",
      "description": "Where the GIF picker searches; also in the dropdown beside its search field.",
      "type": "choice",
      "options": [
        {
          "value": "tenor",
          "label": "Tenor"
        },
        {
          "value": "giphy",
          "label": "Giphy"
        },
        {
          "value": "klipy",
          "label": "Klipy"
        },
        {
          "value": "all",
          "label": "All 3"
        }
      ],
      "default": "tenor"
    }
  ]
}
