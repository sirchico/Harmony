{
  "api_version": 2,
  "id": "reverse-image-search",
  "name": "Reverse Image Search",
  "version": "1.1.0",
  "author": "Harmony contributors",
  "license": "MIT OR Apache-2.0",
  "source": "https://github.com/sirchico/Harmony/tree/main/extensions/plugins/reverse-image-search",
  "kind": "plugin",
  "capabilities": ["media_links", "external_navigation"],
  "actions": [
    {
      "id": "search",
      "label": "Search Image",
      "surface": "image",
      "icon": "search",
      "choices": [
        { "id": "google", "label": "Google", "icon": "search" },
        { "id": "yandex", "label": "Yandex", "icon": "search" },
        { "id": "saucenao", "label": "SauceNAO", "icon": "search" },
        { "id": "iqdb", "label": "IQDB", "icon": "search" },
        { "id": "bing", "label": "Bing", "icon": "search" },
        { "id": "tineye", "label": "TinEye", "icon": "search" },
        { "id": "imgops", "label": "ImgOps", "icon": "search" },
        { "id": "all", "label": "All", "icon": "external" }
      ]
    }
  ],
  "requires": { "features": { "media.links": "^1.0" } }
}
