{
  "api_version": 2,
  "id": "reverse-image-search",
  "name": "Reverse Image Search",
  "version": "1.0.0",
  "author": "Harmony contributors",
  "license": "MIT OR Apache-2.0",
  "source": "https://github.com/sirchico/Harmony/tree/main/extensions/plugins/reverse-image-search",
  "kind": "plugin",
  "capabilities": ["selected_message", "media_links", "external_navigation"],
  "actions": [
    { "id": "search", "label": "Reverse image search", "surface": "message" }
  ],
  "requires": { "features": { "settings": "^1.0", "media.links": "^1.0" } },
  "settings": [
    {
      "id": "engine",
      "label": "Search engine",
      "description": "Used first; you can pick another one for each search.",
      "type": "choice",
      "options": [
        { "value": "google", "label": "Google Lens" },
        { "value": "bing", "label": "Bing" },
        { "value": "yandex", "label": "Yandex" },
        { "value": "tineye", "label": "TinEye" },
        { "value": "saucenao", "label": "SauceNAO" },
        { "value": "iqdb", "label": "IQDB" }
      ],
      "default": "google"
    }
  ]
}
