    {
      "manifest": {
        "api_version": 2,
        "id": "base-decoder",
        "name": "Base64 Decoder",
        "version": "1.1.0",
        "author": "Harmony contributors",
        "license": "MIT OR Apache-2.0",
        "source": "https://github.com/sirchico/Harmony/tree/main/extensions/plugins/base-decoder",
        "kind": "plugin",
        "capabilities": [
          "selected_message",
          "clipboard_write"
        ],
        "actions": [
          {
            "id": "decode",
            "label": "Decode Base64",
            "surface": "message_toolbar",
            "icon": "code"
          }
        ],
        "requires": {
          "features": {
            "settings": "^1.0"
          }
        },
        "settings": [
          {
            "id": "click",
            "label": "Decode button",
            "description": "Change what the decode button on messages does.",
            "type": "choice",
            "options": [
              {
                "value": "window",
                "label": "Show the decoded text in a window"
              },
              {
                "value": "copy",
                "label": "Copy the decoded text"
              }
            ],
            "default": "window"
          }
        ]
      },
      "release_url": "https://raw.githubusercontent.com/sirchico/Harmony/36e99d5efa2294ecbb1f155456a6351ae31c4118/extensions/plugins/packages/base-decoder.harmony-extension",
