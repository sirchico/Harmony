    {
      "manifest": {
        "api_version": 2,
        "id": "copy-file-contents",
        "name": "Copy File Contents",
        "version": "1.1.0",
        "author": "Harmony contributors",
        "license": "MIT OR Apache-2.0",
        "source": "https://github.com/sirchico/Harmony/tree/main/extensions/plugins/copy-file-contents",
        "kind": "plugin",
        "capabilities": [
          "media_links",
          "attachment_contents",
          "clipboard_write"
        ],
        "actions": [
          {
            "id": "copy",
            "label": "Copy File Contents",
            "surface": "attachment",
            "icon": "copy",
            "accepts": {
              "content_types": [
                "text/",
                "application/json",
                "application/xml",
                "application/x-sh",
                "application/javascript"
              ],
              "extensions": [
                "txt",
                "md",
                "log",
                "json",
                "toml",
                "yaml",
                "yml",
                "xml",
                "csv",
                "tsv",
                "ini",
                "cfg",
                "conf",
                "rs",
                "py",
                "js",
                "ts",
                "tsx",
                "jsx",
                "c",
                "h",
                "cpp",
                "hpp",
                "cs",
                "java",
                "kt",
                "go",
                "rb",
                "php",
                "lua",
                "sh",
                "ps1",
                "bat",
                "sql",
                "html",
                "css",
                "scss",
                "diff",
                "patch",
                "srt",
                "env"
              ],
              "max_bytes": 65536
            }
          }
        ],
        "requires": {
          "features": {
            "host_requests": "^1.0",
            "media.links": "^1.0",
            "attachments.read": "^1.0"
          }
        }
      },
      "release_url": "https://raw.githubusercontent.com/sirchico/Harmony/36e99d5efa2294ecbb1f155456a6351ae31c4118/extensions/plugins/packages/copy-file-contents.harmony-extension",
      "sha256": "0f9d6f6cad5035f1000984937158c531649723d7a57638d1808ca71787bd6141",
      "download_bytes": 1654119,
      "source_commit": "36e99d5efa2294ecbb1f155456a6351ae31c4118",
